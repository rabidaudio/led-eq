{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build firmware simulation",
            "type": "shell",
            "command": "iverilog -g2012 -gsupported-assertions -o build/sim.vvp testbench.sv",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run firmware simulation",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "command": "vvp build/sim.vvp",
            "dependsOn": [
                "Build firmware simulation"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "View simulation results",
            "type": "shell",
            "command": "surfer build/results.vcd",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Synthesize firmware",
            "type": "shell",
            "command": "${workspaceFolder}/firmware/build.sh",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            }
        },
        {
            "label": "Load firmware",
            "type": "shell",
            "command": "cp build/proj.bin /Volumes/iCELink",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "dependsOn": [
                "Synthesize firmware"
            ],
            "problemMatcher": []
        }
    ]
}